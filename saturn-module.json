{
  "id": "storage",
  "name": "Data & Storage",
  "version": "1.0.0",
  "description": "JSON, YAML, TOML, XML, INI/.env, CSV and SQL files",
  "badge": "{}",
  "saturnApi": "^0.1",
  "main": "module.js",
  "activationEvents": [
    "workspaceContains:**/*.yaml",
    "workspaceContains:**/*.yml",
    "workspaceContains:**/*.toml",
    "workspaceContains:**/*.xml",
    "workspaceContains:**/*.csv",
    "workspaceContains:**/*.tsv",
    "workspaceContains:**/*.sql"
  ],
  "contributes": {
    "languages": [
      {
        "id": "json",
        "name": "JSON",
        "extensions": [".json", ".jsonc", ".jsonl", ".ndjson", ".geojson", ".webmanifest", ".har", ".babelrc"],
        "grammar": "grammars/json.tmLanguage.json",
        "scopeName": "source.json"
      },
      {
        "id": "yaml",
        "name": "YAML",
        "extensions": [".yaml", ".yml"],
        "grammar": "grammars/yaml.tmLanguage.json",
        "scopeName": "source.yaml"
      },
      {
        "id": "toml",
        "name": "TOML",
        "extensions": [".toml", "cargo.lock", "poetry.lock", "uv.lock"],
        "grammar": "grammars/toml.tmLanguage.json",
        "scopeName": "source.toml"
      },
      {
        "id": "xml",
        "name": "XML",
        "extensions": [".xml", ".xsd", ".xsl", ".xslt", ".plist", ".rss", ".atom", ".wsdl", ".kml", ".gpx"],
        "grammar": "grammars/xml.tmLanguage.json",
        "scopeName": "text.xml"
      },
      {
        "id": "ini",
        "name": "INI",
        "extensions": [
          ".ini", ".cfg", ".cnf", ".properties", ".editorconfig", ".gitconfig", ".npmrc",
          ".env", ".env.local", ".env.example", ".env.development", ".env.production", ".env.test"
        ],
        "grammar": "grammars/ini.tmLanguage.json",
        "scopeName": "source.ini"
      },
      {
        "id": "csv",
        "name": "CSV",
        "extensions": [".csv"],
        "grammar": "grammars/csv.tmLanguage.json",
        "scopeName": "text.csv"
      },
      {
        "id": "tsv",
        "name": "TSV",
        "extensions": [".tsv", ".tab"],
        "grammar": "grammars/tsv.tmLanguage.json",
        "scopeName": "text.tsv"
      },
      {
        "id": "sql",
        "name": "SQL",
        "extensions": [".sql", ".ddl"],
        "grammar": "grammars/sql.tmLanguage.json",
        "scopeName": "source.sql"
      }
    ],
    "languageServer": {
      "languages": ["json", "yaml", "toml", "xml", "ini", "sql"],
      "command": "node",
      "args": ["server/server.js", "--stdio"]
    },
    "previews": [
      { "id": "storage.json", "label": "JSON", "extensions": [".json", ".jsonc", ".jsonl", ".ndjson", ".geojson", ".webmanifest", ".har", ".babelrc"] },
      { "id": "storage.yaml", "label": "YAML", "extensions": [".yaml", ".yml"] },
      { "id": "storage.toml", "label": "TOML", "extensions": [".toml", "cargo.lock", "poetry.lock", "uv.lock"] },
      { "id": "storage.xml", "label": "XML", "extensions": [".xml", ".xsd", ".xsl", ".xslt", ".plist", ".rss", ".atom", ".wsdl", ".kml", ".gpx"] },
      {
        "id": "storage.ini",
        "label": "Settings",
        "extensions": [
          ".ini", ".cfg", ".cnf", ".properties", ".editorconfig", ".gitconfig", ".npmrc",
          ".env", ".env.local", ".env.example", ".env.development", ".env.production", ".env.test"
        ]
      },
      { "id": "storage.csv", "label": "Table", "extensions": [".csv", ".tsv", ".tab"] },
      { "id": "storage.sql", "label": "Schema", "extensions": [".sql", ".ddl"] }
    ],
    "fileTemplates": [
      { "id": "storage.jsonFile", "label": "JSON File", "kind": "file", "extension": ".json", "placeholder": "data" },
      { "id": "storage.yamlFile", "label": "YAML File", "kind": "file", "extension": ".yaml", "placeholder": "config" },
      { "id": "storage.tomlFile", "label": "TOML File", "kind": "file", "extension": ".toml", "placeholder": "config" },
      { "id": "storage.xmlFile", "label": "XML File", "kind": "file", "extension": ".xml", "placeholder": "data" },
      { "id": "storage.csvFile", "label": "CSV File", "kind": "file", "extension": ".csv", "placeholder": "table" },
      { "id": "storage.sqlFile", "label": "SQL File", "kind": "file", "extension": ".sql", "placeholder": "schema" }
    ]
  }
}
