{
  "name": "CSV",
  "scopeName": "text.csv",
  "fileTypes": [
    "csv"
  ],
  "patterns": [
    {
      "match": "(?=[^\\n])(\"(?:[^\"]|\"\")*\"|[^,\"\\n]*)(,|$)(?:(\"(?:[^\"]|\"\")*\"|[^,\"\\n]*)(,|$))?(?:(\"(?:[^\"]|\"\")*\"|[^,\"\\n]*)(,|$))?(?:(\"(?:[^\"]|\"\")*\"|[^,\"\\n]*)(,|$))?(?:(\"(?:[^\"]|\"\")*\"|[^,\"\\n]*)(,|$))?(?:(\"(?:[^\"]|\"\")*\"|[^,\"\\n]*)(,|$))?",
      "captures": {
        "1": {
          "name": "variable.other.column-1.csv"
        },
        "2": {
          "name": "punctuation.separator.csv"
        },
        "3": {
          "name": "string.unquoted.column-2.csv"
        },
        "4": {
          "name": "punctuation.separator.csv"
        },
        "5": {
          "name": "keyword.other.column-3.csv"
        },
        "6": {
          "name": "punctuation.separator.csv"
        },
        "7": {
          "name": "entity.name.function.column-4.csv"
        },
        "8": {
          "name": "punctuation.separator.csv"
        },
        "9": {
          "name": "entity.name.type.column-5.csv"
        },
        "10": {
          "name": "punctuation.separator.csv"
        },
        "11": {
          "name": "constant.numeric.column-6.csv"
        },
        "12": {
          "name": "punctuation.separator.csv"
        }
      }
    }
  ]
}
