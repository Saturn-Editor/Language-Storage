{
  "name": "INI",
  "scopeName": "source.ini",
  "fileTypes": [
    "ini",
    "cfg",
    "cnf",
    "properties",
    "env",
    "editorconfig",
    "gitconfig",
    "npmrc"
  ],
  "patterns": [
    {
      "match": "^[ \\t]*[;#!].*$",
      "name": "comment.line.ini"
    },
    {
      "match": "^[ \\t]*(\\[)([^\\]\\n]*)(\\])",
      "captures": {
        "1": {
          "name": "punctuation.definition.section.ini"
        },
        "2": {
          "name": "entity.name.type.section.ini entity.name.section.ini"
        },
        "3": {
          "name": "punctuation.definition.section.ini"
        }
      }
    },
    {
      "begin": "^[ \\t]*(?:(export)[ \\t]+)?((?:\\\\.|[^\\\\=:\\s;#\\[])(?:\\\\.|[^\\\\=:\\n])*?)[ \\t]*([=:])",
      "end": "(?<!\\\\)$",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.export.ini storage.modifier.export.ini"
        },
        "2": {
          "name": "variable.other.property.ini"
        },
        "3": {
          "name": "punctuation.separator.key-value.ini"
        }
      },
      "patterns": [
        {
          "include": "#value"
        }
      ]
    },
    {
      "match": "^[ \\t]*([\\w.-]+)[ \\t]*$",
      "captures": {
        "1": {
          "name": "variable.other.property.ini"
        }
      }
    }
  ],
  "repository": {
    "value": {
      "patterns": [
        {
          "match": "(?<=\\s)[;#].*$",
          "name": "comment.line.ini"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.ini",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.ini"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.ini"
        },
        {
          "include": "#interpolation"
        },
        {
          "match": "(?i)(?<=[=:\\s])(?:true|false|yes|no|on|off|null)(?=[ \\t]*(?:[;#].*)?$)",
          "name": "keyword.constant.ini constant.language.ini"
        },
        {
          "match": "(?<=[=:\\s])[-+]?\\d+(?:\\.\\d+)?(?=[ \\t]*(?:[;#].*)?$)",
          "name": "constant.numeric.ini"
        }
      ]
    },
    "interpolation": {
      "match": "\\$\\{[^}\\n]*\\}|\\$[A-Za-z_]\\w*|%\\([^)\\n]*\\)s",
      "name": "variable.other.interpolation.ini"
    }
  }
}
